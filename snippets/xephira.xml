<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <remote name="xephira"
          fetch="https://github.com/temp-XephiraOS" />

  <!-- Removed upstream repositories for XephiraOS customizations -->
  <remove-project name="LineageOS/android" />
  <remove-project name="LineageOS/android_build" />
  <remove-project name="LineageOS/android_frameworks_base" />
  <remove-project name="LineageOS/android_packages_apps_Settings" />
  <remove-project name="LineageOS/android_vendor_lineage" />

  <!-- XephiraOS Core Overrides -->
  <project path="android" name="android" remote="xephira" />

  <project path="build/make" name="android_build" groups="pdk,sysui-studio" remote="xephira">
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
    <linkfile src="target" dest="build/target" />
    <linkfile src="tools" dest="build/tools" />
  </project>

  <project path="frameworks/base" name="android_frameworks_base" groups="pdk-cw-fs,pdk-fs,sysui-studio" remote="xephira" />

  <project path="packages/apps/Settings" name="android_packages_apps_Settings" groups="pdk-fs,pdk-cw-tvc,sysui-studio" remote="xephira" />

  <project path="vendor/lineage" name="android_vendor_lineage" remote="xephira" />

  <!-- XephiraOS Additions -->
  <project path="vendor/gms" name="vendor_gms" remote="xephira" revision="cnb" clone-depth="1" />
  <project path="vendor/pixel-style" name="vendor_pixel-style" remote="xephira" revision="cnb" clone-depth="1" />

</manifest>

